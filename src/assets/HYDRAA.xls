<?xml version="1.0"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:html="http://www.w3.org/TR/REC-html40">
 <DocumentProperties xmlns="urn:schemas-microsoft-com:office:office">
  <Version>16.00</Version>
 </DocumentProperties>
 <OfficeDocumentSettings xmlns="urn:schemas-microsoft-com:office:office">
  <AllowPNG/>
 </OfficeDocumentSettings>
 <ExcelWorkbook xmlns="urn:schemas-microsoft-com:office:excel">
  <WindowHeight>7490</WindowHeight>
  <WindowWidth>19200</WindowWidth>
  <WindowTopX>32767</WindowTopX>
  <WindowTopY>32767</WindowTopY>
  <ActiveSheet>3</ActiveSheet>
  <ProtectStructure>False</ProtectStructure>
  <ProtectWindows>False</ProtectWindows>
 </ExcelWorkbook>
 <Styles>
  <Style ss:ID="Default" ss:Name="Normal">
   <Alignment ss:Vertical="Bottom"/>
   <Borders/>
   <Font ss:FontName="Aptos Narrow" x:Family="Swiss" ss:Size="11"
    ss:Color="#000000"/>
   <Interior/>
   <NumberFormat/>
   <Protection/>
  </Style>
  <Style ss:ID="s62">
   <Alignment ss:Vertical="Bottom"/>
   <Borders/>
   <Font ss:FontName="Arial" ss:Color="#0000FF" ss:Bold="1"/>
   <Interior ss:Color="#0284C7" ss:Pattern="Solid"/>
   <NumberFormat/>
   <Protection/>
  </Style>
 </Styles>
 <Worksheet ss:Name="HYDRAA Log">
  <Table ss:ExpandedColumnCount="9" ss:ExpandedRowCount="1" x:FullColumns="1"
   x:FullRows="1" ss:DefaultRowHeight="14.5">
   <Row>
    <Cell ss:StyleID="s62"><Data ss:Type="String">Date</Data></Cell>
    <Cell ss:StyleID="s62"><Data ss:Type="String">Time</Data></Cell>
    <Cell ss:StyleID="s62"><Data ss:Type="String">Drink Type</Data></Cell>
    <Cell ss:StyleID="s62"><Data ss:Type="String">Amount (ml)</Data></Cell>
    <Cell ss:StyleID="s62"><Data ss:Type="String">Type</Data></Cell>
    <Cell ss:StyleID="s62"><Data ss:Type="String">Source</Data></Cell>
    <Cell ss:StyleID="s62"><Data ss:Type="String">Snooze (min)</Data></Cell>
    <Cell ss:StyleID="s62"><Data ss:Type="String">Water Total (ml)</Data></Cell>
    <Cell ss:StyleID="s62"><Data ss:Type="String">Daily Goal (ml)</Data></Cell>
   </Row>
  </Table>
  <WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel">
   <Panes>
    <Pane>
     <Number>3</Number>
     <ActiveRow>1</ActiveRow>
     <RangeSelection>R2:R5</RangeSelection>
    </Pane>
   </Panes>
   <ProtectObjects>False</ProtectObjects>
   <ProtectScenarios>False</ProtectScenarios>
  </WorksheetOptions>
 </Worksheet>
 <Worksheet ss:Name="Summary">
  <Table ss:ExpandedColumnCount="2" ss:ExpandedRowCount="10" x:FullColumns="1"
   x:FullRows="1" ss:DefaultRowHeight="14.5">
   <Row>
    <Cell ss:StyleID="s62"><Data ss:Type="String">Metric</Data></Cell>
    <Cell ss:StyleID="s62"><Data ss:Type="String">Value</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Water (ml)</Data></Cell>
    <Cell><Data ss:Type="Number">0</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Coffee (ml)</Data></Cell>
    <Cell><Data ss:Type="Number">0</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Tea (ml)</Data></Cell>
    <Cell><Data ss:Type="Number">0</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Soda (ml)</Data></Cell>
    <Cell><Data ss:Type="Number">0</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Juice (ml)</Data></Cell>
    <Cell><Data ss:Type="Number">0</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Total Drink Entries</Data></Cell>
    <Cell><Data ss:Type="Number">0</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Snoozed</Data></Cell>
    <Cell><Data ss:Type="Number">0</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Skipped</Data></Cell>
    <Cell><Data ss:Type="Number">0</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Default Daily Goal (ml)</Data></Cell>
    <Cell><Data ss:Type="Number">2200</Data></Cell>
   </Row>
  </Table>
  <WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel">
   <Panes>
    <Pane>
     <Number>3</Number>
     <ActiveRow>9</ActiveRow>
     <ActiveCol>1</ActiveCol>
    </Pane>
   </Panes>
   <ProtectObjects>False</ProtectObjects>
   <ProtectScenarios>False</ProtectScenarios>
  </WorksheetOptions>
 </Worksheet>
 <Worksheet ss:Name="HYDRAA Config">
  <Table ss:ExpandedColumnCount="2" ss:ExpandedRowCount="10" x:FullColumns="1"
   x:FullRows="1" ss:DefaultRowHeight="14.5">
   <Column ss:Index="2" ss:AutoFitWidth="0" ss:Width="86.5"/>
   <Row>
    <Cell ss:StyleID="s62"><Data ss:Type="String">Setting</Data></Cell>
    <Cell ss:StyleID="s62"><Data ss:Type="String">Value</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Daily Goal</Data></Cell>
    <Cell><Data ss:Type="String">2000</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Reminder Interval</Data></Cell>
    <Cell><Data ss:Type="String">45</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Snooze Durations</Data></Cell>
    <Cell><Data ss:Type="String">5,10,15,30</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Reminder Enabled</Data></Cell>
    <Cell><Data ss:Type="String">true</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Sound Choice</Data></Cell>
    <Cell><Data ss:Type="String">fahh</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Sound Volume</Data></Cell>
    <Cell><Data ss:Type="String">0.85</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Sound Enabled</Data></Cell>
    <Cell><Data ss:Type="String">true</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Theme</Data></Cell>
    <Cell><Data ss:Type="String">dark</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Exported At</Data></Cell>
    <Cell><Data ss:Type="String">7/28/2026, 4:08:27 AM</Data></Cell>
   </Row>
  </Table>
  <WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel">
   <Panes>
    <Pane>
     <Number>3</Number>
     <ActiveRow>8</ActiveRow>
     <ActiveCol>3</ActiveCol>
    </Pane>
   </Panes>
   <ProtectObjects>False</ProtectObjects>
   <ProtectScenarios>False</ProtectScenarios>
  </WorksheetOptions>
 </Worksheet>
 <Worksheet ss:Name="Daily Goals">
  <Table ss:ExpandedColumnCount="2" ss:ExpandedRowCount="2" x:FullColumns="1"
   x:FullRows="1" ss:DefaultRowHeight="14.5">
   <Row>
    <Cell ss:StyleID="s62"><Data ss:Type="String">Date</Data></Cell>
    <Cell ss:StyleID="s62"><Data ss:Type="String">Goal (ml)</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">2026-07-28</Data></Cell>
    <Cell><Data ss:Type="Number">2200</Data></Cell>
   </Row>
  </Table>
  <WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel">
   <Selected/>
   <Panes>
    <Pane>
     <Number>3</Number>
     <ActiveRow>2</ActiveRow>
     <ActiveCol>1</ActiveCol>
    </Pane>
   </Panes>
   <ProtectObjects>False</ProtectObjects>
   <ProtectScenarios>False</ProtectScenarios>
  </WorksheetOptions>
 </Worksheet>
</Workbook>
